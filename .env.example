# Email Configuration for Contact Form
# Copy this file to .env.local and fill in your actual values

# SMTP Configuration (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Contact Email (where to send form submissions)
CONTACT_EMAIL=info@visiondefence-security.co.uk

# Security Note:
# - For Gmail, enable "Less secure app access" or use an App Password
# - Never commit your actual .env.local file to version control
# - Keep your email credentials secure
